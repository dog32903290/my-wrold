{
  "version": 1,
  "source": "Tooll3 interaction contract, not copied code",
  "initialGraph": "fixtures/storage/minimal-work/patches/main.patch.json",
  "traces": [
    {
      "name": "move shader node",
      "expectedCommands": ["move_node"]
    },
    {
      "name": "connect shader to output",
      "expectedCommands": ["disconnect", "connect"]
    },
    {
      "name": "delete selected edge",
      "expectedCommands": ["disconnect", "undo:disconnect"]
    },
    {
      "name": "delete selected node",
      "expectedCommands": ["delete_node", "undo:delete_node"]
    },
    {
      "name": "create output node from dragged port",
      "expectedCommands": ["create_node+connect"]
    },
    {
      "name": "reconnect input end",
      "expectedCommands": ["reconnect", "undo:reconnect", "redo:reconnect"]
    },
    {
      "name": "reconnect output beginning",
      "expectedCommands": ["reconnect", "undo:reconnect", "redo:reconnect"]
    },
    {
      "name": "split edge create operator",
      "expectedCommands": ["split_edge_create_node", "undo:split_edge_create_node", "redo:split_edge_create_node"]
    },
    {
      "name": "drop connection onto operator hidden input",
      "expectedCommands": ["connect_hidden_input", "undo:connect_hidden_input", "redo:connect_hidden_input"]
    },
    {
      "name": "multi input insert before",
      "expectedCommands": ["multi_input_insert", "undo:multi_input_insert", "redo:multi_input_insert"]
    },
    {
      "name": "drag existing node onto edge insert",
      "expectedCommands": ["insert_node_on_edge", "undo:insert_node_on_edge", "redo:insert_node_on_edge"]
    },
    {
      "name": "snap connect unsnap disconnect",
      "expectedCommands": ["snap_connect", "unsnap_disconnect", "undo:unsnap_disconnect"]
    },
    {
      "name": "shake disconnect dragged node edges",
      "expectedCommands": ["shake_disconnect", "undo:shake_disconnect", "redo:shake_disconnect"]
    },
    {
      "name": "compound enter exit collapse",
      "expectedCommands": ["create_node", "enter_patch", "exit_patch", "collapse_compound"]
    },
    {
      "name": "compound collapsed drag expanded roundtrip",
      "expectedCommands": ["create_node", "collapse_compound", "move_node", "enter_patch", "save_work:saved-and-committed"]
    },
    {
      "name": "compound public ports persist undo",
      "expectedCommands": ["create_node", "create_node", "create_node", "connect", "connect", "save_work:saved-and-committed", "disconnect", "undo:disconnect", "redo:disconnect"]
    },
    {
      "name": "inspector param and binding",
      "expectedCommands": ["set_param", "set_port_binding"]
    },
    {
      "name": "undo redo save",
      "expectedCommands": ["move_node", "undo:move_node", "redo:move_node", "save_work:saved-and-committed"]
    }
  ]
}
