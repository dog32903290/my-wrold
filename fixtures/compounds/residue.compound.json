{
  "type": "compound.residue",
  "displayName": "Residue",
  "collapsedByDefault": true,
  "children": [
    { "id": "audio_in", "type": "audio.input", "role": "Raw audio input adapter" },
    { "id": "mono_mix", "type": "audio.mono_mix", "role": "Fold channels into one mono analysis lane" },
    { "id": "rms", "type": "analyzer.rms", "role": "Measure raw RMS and peak facts" },
    { "id": "sustain", "type": "analyzer.sustain", "role": "Arm residue only from held active energy" },
    { "id": "silence", "type": "analyzer.silence", "role": "Clear residue after stable silence" },
    { "id": "residue", "type": "analyzer.residue", "role": "Detect tail state after held energy drops" },
    { "id": "residue_out", "type": "analyzer.residue_out", "role": "Publish residue detector public outputs" }
  ],
  "internalEdges": [
    { "from": "audio.in", "to": "audio_in.input", "dataType": "audio.channels" },
    { "from": "audio_in.channels", "to": "mono_mix.input", "dataType": "audio.channels" },
    { "from": "mono_mix.mono", "to": "rms.input", "dataType": "audio.mono" },
    { "from": "rms.rms", "to": "sustain.rms", "dataType": "signal.float" },
    { "from": "rms.peak", "to": "sustain.peak", "dataType": "signal.float" },
    { "from": "rms.rms", "to": "silence.rms", "dataType": "signal.float" },
    { "from": "rms.peak", "to": "silence.peak", "dataType": "signal.float" },
    { "from": "rms.rms", "to": "residue.rms", "dataType": "signal.float" },
    { "from": "sustain.sustain_envelope", "to": "residue.sustain_envelope", "dataType": "signal.float" },
    { "from": "silence.silence_state", "to": "residue.silence_state", "dataType": "signal.float" },
    { "from": "residue.residue_state", "to": "residue_out.residue_state", "dataType": "signal.float" },
    { "from": "residue.residue_envelope", "to": "residue_out.residue_envelope", "dataType": "signal.float" },
    { "from": "residue.residue_timer_ms", "to": "residue_out.residue_timer_ms", "dataType": "signal.float" },
    { "from": "residue.confidence", "to": "residue_out.confidence", "dataType": "signal.float" }
  ],
  "publicInputs": [
    { "id": "audio.in", "label": "Audio In", "dataType": "audio.channels", "direction": "in", "mapsTo": "audio_in.input" }
  ],
  "publicOutputs": [
    { "id": "residue_state", "label": "Residue State", "dataType": "signal.float", "direction": "out", "mapsTo": "residue_out.residue_state" },
    { "id": "residue_envelope", "label": "Residue Envelope", "dataType": "signal.float", "direction": "out", "mapsTo": "residue_out.residue_envelope" },
    { "id": "residue_timer_ms", "label": "Residue Timer Ms", "dataType": "signal.float", "direction": "out", "mapsTo": "residue_out.residue_timer_ms" },
    { "id": "confidence", "label": "Confidence", "dataType": "signal.float", "direction": "out", "mapsTo": "residue_out.confidence" }
  ]
}
